# Sumber data pasar saham IDX:
#   yahoo   = gratis, tertunda ±10-15 menit
#   invezgo = Invezgo API (berbayar, data intraday BEI) — isi INVEZGO_API_KEY
#   goapi   = GoAPI Stock Market IDX (berbayar) — isi GOAPI_API_KEY
#   demo    = data sintetis, offline
MARKET_DATA_PROVIDER=yahoo
INVEZGO_API_KEY=
INVEZGO_BASE_URL=https://api.invezgo.com
GOAPI_API_KEY=
GOAPI_BASE_URL=https://api.goapi.io
# Bila invezgo/goapi gagal atau tidak menyediakan data tertentu (mis. candle intraday GoAPI):
# yahoo / demo / none
VENDOR_FALLBACK=yahoo

# Modal awal akun paper trading (Rupiah)
PAPER_STARTING_CASH=100000000

# Biaya transaksi (persen). Default mendekati tarif broker ritel umum di IDX.
BUY_FEE_PCT=0.15
SELL_FEE_PCT=0.25

# Batas risiko: maksimum persen ekuitas untuk satu order
MAX_POSITION_PCT=20

# Order ke broker sungguhan HANYA dikirim bila ini "true".
ENABLE_LIVE_TRADING=false

# Notifikasi Telegram (opsional; bisa juga diisi lewat tab "Notifikasi" di UI).
# 1) Chat @BotFather -> /newbot -> salin token. 2) Kirim pesan apa saja ke bot Anda.
# 3) Klik "Cari chat ID" di UI, atau buka https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Analisis fundamental (laporan keuangan XBRL dari IDX)
# Kosongkan untuk memakai data/fundamentals/XBRL. Bisa diarahkan ke folder data/XBRL hasil
# https://github.com/septianbyk/idx-financial-scraper (tata letak foldernya sama).
FUNDAMENTALS_XBRL_DIR=
# Kurs untuk emiten yang melaporkan dalam USD (harga saham tetap dalam Rupiah)
USD_IDR_RATE=16000

# Webhook alert TradingView: request yang datang lewat tunnel (ngrok / Cloudflare Tunnel) hanya
# diizinkan ke /api/webhooks/tradingview. Jangan dimatikan kecuali Anda paham risikonya.
LOCAL_ONLY_GUARD=true

# Database SQLite (satu file). Kosong = <DATA_DIR>/app.db
DATABASE_PATH=

# Batas Auto Rejection (ARA/ARB) dalam persen, untuk harga acuan Rp50–200, >200–5.000, >5.000.
# Bawaan = aturan IDX sejak April 2025. Sesuaikan bila bursa mengubah aturan.
AUTO_REJECTION_ARA=35,25,20
AUTO_REJECTION_ARB=15,15,15

# Mode live (detik): seberapa sering harga diambil ulang. Jangan terlalu kecil agar tidak kena
# batas permintaan Yahoo. Data Yahoo untuk IDX sendiri tertunda ±10–15 menit dari bursa.
LIVE_FOCUS_SECONDS=10
LIVE_WATCH_SECONDS=30

# ---- Crypto (Binance) ----
# Data harga crypto diambil dari endpoint publik Binance (tanpa API key). Bila api.binance.com
# tidak bisa diakses dari jaringan Anda, coba https://data-api.binance.vision (khusus data pasar).
BINANCE_DATA_URL=https://api.binance.com
# Binance Spot Testnet (uang palsu) — buat API key di https://testnet.binance.vision
BINANCE_TESTNET_URL=https://testnet.binance.vision
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# Akun Binance ASLI (uang sungguhan). Buat API key dengan izin Spot Trading saja (JANGAN izin
# withdraw), batasi ke IP komputer Anda. Order asli juga butuh ENABLE_LIVE_TRADING=true.
BINANCE_API_URL=https://api.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Akun simulasi crypto
CRYPTO_PAPER_STARTING_USDT=10000
CRYPTO_FEE_PCT=0.1
CRYPTO_MAX_POSITION_PCT=20

# ---- Saham Amerika ----
# Data: Finnhub (https://finnhub.io, API key gratis; harga real-time AS, 60 permintaan/menit) atau Alpaca.
# auto = Finnhub bila FINNHUB_API_KEY diisi, selain itu Alpaca. Order bisa lewat akun simulasi lokal
# (bawaan, tanpa broker) atau akun Alpaca di bawah.
US_DATA_PROVIDER=auto
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
US_PAPER_STARTING_USD=100000
# ---- Alpaca Markets (opsional) ----
# Buat API key di https://alpaca.markets. Akun Paper = uang simulasi (disarankan untuk mulai).
# Feed "iex" gratis & real-time tetapi hanya memuat transaksi bursa IEX; "sip" berbayar (seluruh bursa AS).
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex
ALPACA_PAPER_URL=https://paper-api.alpaca.markets
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
# Akun live (uang sungguhan) juga butuh ENABLE_LIVE_TRADING=true dan konfirmasi di setiap order.
ALPACA_LIVE_URL=https://api.alpaca.markets
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=
US_MAX_POSITION_PCT=20
# Batas nilai satu order di akun live (USD)
US_MAX_ORDER_USD=1000

# Alert harga Telegram: seberapa sering harga dicek terhadap target (detik)
PRICE_ALERT_SECONDS=30
