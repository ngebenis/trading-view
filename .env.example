# Sumber data pasar: "yahoo" (data nyata, delay ~10-15 menit untuk IDX) atau "demo" (data sintetis, offline)
MARKET_DATA_PROVIDER=yahoo

# Modal awal akun paper trading (Rupiah)
PAPER_STARTING_CASH=100000000

# Biaya transaksi (persen). Default mendekati tarif broker ritel umum di IDX.
BUY_FEE_PCT=0.15
SELL_FEE_PCT=0.25

# Batas risiko: maksimum persen ekuitas untuk satu order
MAX_POSITION_PCT=20

# Order ke broker sungguhan HANYA dikirim bila ini "true".
ENABLE_LIVE_TRADING=false

# Notifikasi Telegram (opsional; bisa juga diisi lewat tab "Notifikasi" di UI).
# 1) Chat @BotFather -> /newbot -> salin token. 2) Kirim pesan apa saja ke bot Anda.
# 3) Klik "Cari chat ID" di UI, atau buka https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Analisis fundamental (laporan keuangan XBRL dari IDX)
# Kosongkan untuk memakai data/fundamentals/XBRL. Bisa diarahkan ke folder data/XBRL hasil
# https://github.com/septianbyk/idx-financial-scraper (tata letak foldernya sama).
FUNDAMENTALS_XBRL_DIR=
# Kurs untuk emiten yang melaporkan dalam USD (harga saham tetap dalam Rupiah)
USD_IDR_RATE=16000

# Webhook alert TradingView: request yang datang lewat tunnel (ngrok / Cloudflare Tunnel) hanya
# diizinkan ke /api/webhooks/tradingview. Jangan dimatikan kecuali Anda paham risikonya.
LOCAL_ONLY_GUARD=true

# Database SQLite (satu file). Kosong = <DATA_DIR>/app.db
DATABASE_PATH=

# Batas Auto Rejection (ARA/ARB) dalam persen, untuk harga acuan Rp50–200, >200–5.000, >5.000.
# Bawaan = aturan IDX sejak April 2025. Sesuaikan bila bursa mengubah aturan.
AUTO_REJECTION_ARA=35,25,20
AUTO_REJECTION_ARB=15,15,15

# Mode live (detik): seberapa sering harga diambil ulang. Jangan terlalu kecil agar tidak kena
# batas permintaan Yahoo. Data Yahoo untuk IDX sendiri tertunda ±10–15 menit dari bursa.
LIVE_FOCUS_SECONDS=10
LIVE_WATCH_SECONDS=30
